# nginx for the web app. The image's entrypoint fills in ${API_URL} and
# ${NGINX_LOCAL_RESOLVERS} when the container starts; nginx's own variables
# ($uri…) are left alone.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    add_header X-Content-Type-Options nosniff always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite puts a content hash in these names: they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # The API sends no CORS headers, so the app calls it under /api on its own
    # origin. API_URL has no trailing slash; it is resolved per request, so the
    # container starts even when the API is not reachable yet.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        set $api "${API_URL}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single-page app: every other path is a client-side route. The page is
    # revalidated each time so a new release is picked up at once.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /index.html;
    }
}
